# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# JWT (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-secret-key-here

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=seams_dev
DB_USER=postgres
DB_PASSWORD=postgres
# DB_SSL=true          # Set to 'true' for cloud databases (Render, Supabase, etc.)

# Production: use DATABASE_URL instead of individual DB_* vars
# DATABASE_URL=postgresql://user:password@host:5432/seams_prod

# ─── Connection Pool ──────────────────────────────────────────────────────────
# DB_POOL_MIN=2
# DB_POOL_MAX=10       # Development default. Use 20 in production.

# ─── Read Replica (optional) ──────────────────────────────────────────────────
# If set, SELECT queries route through replica; writes stay on primary
# REPLICA_DATABASE_URL=postgresql://user:pass@replica-host:5432/seams_prod
# DB_READ_POOL_MIN=2
# DB_READ_POOL_MAX=10

# ─── Monitoring ───────────────────────────────────────────────────────────────
# SLOW_QUERY_MS=500    # Log DB queries slower than this (milliseconds)
# SLOW_API_MS=1000     # Log API requests slower than this (milliseconds)
# DB_DEBUG=false       # Print all SQL in development

# ─── Redis Cache (optional) ──────────────────────────────────────────────────
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_NAME=SEAMS Support
FROM_EMAIL=noreply@seams.com

# ─── Frontend ────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

